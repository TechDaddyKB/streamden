{
  "$comment": "@generated by `cargo xtask codegen` (den-protocol); do not edit.",
  "$defs": {
    "Author": {
      "additionalProperties": false,
      "description": "The plugin author (§11, B2).",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "email": {
          "description": "Contact email.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "url": {
          "description": "Homepage or profile URL.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Contributes": {
      "additionalProperties": false,
      "description": "What a plugin contributes (§11). Kinds other than events and operations are carried as opaque JSON\nuntil spec 12 fixes their schemas.",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "chatSources": {
          "default": [],
          "description": "Multichat sources (spec 08/12).",
          "items": true,
          "type": "array"
        },
        "commands": {
          "default": [],
          "description": "Chat commands (spec 12).",
          "items": true,
          "type": "array"
        },
        "conditions": {
          "default": [],
          "description": "Conditions usable in `If` nodes (spec 12).",
          "items": true,
          "type": "array"
        },
        "events": {
          "default": [],
          "description": "Event types (also trigger types, §6.2). Each becomes `<slug>.<id>`.",
          "items": {
            "$ref": "#/$defs/EventContribution"
          },
          "type": "array"
        },
        "operations": {
          "default": [],
          "description": "Operations (sub-actions, methods and MCP tools in one, §8.1). Each becomes `<slug>.<id>`.",
          "items": {
            "$ref": "#/$defs/OperationContribution"
          },
          "type": "array"
        },
        "overlayWidgets": {
          "default": [],
          "description": "Overlay widgets (spec 09/12).",
          "items": true,
          "type": "array"
        },
        "panels": {
          "default": [],
          "description": "UI panels (spec 07/12).",
          "items": true,
          "type": "array"
        },
        "templates": {
          "default": [],
          "description": "Action templates (spec 12).",
          "items": true,
          "type": "array"
        },
        "ttsVoices": {
          "default": [],
          "description": "TTS voice providers (spec 10/12).",
          "items": true,
          "type": "array"
        },
        "variables": {
          "default": [],
          "description": "Variables the plugin maintains (spec 12).",
          "items": true,
          "type": "array"
        }
      },
      "type": "object"
    },
    "Engines": {
      "additionalProperties": false,
      "description": "Host version requirements (§11).",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "pluginApi": {
          "description": "Plugin API range (SemVer range), e.g. `^0.1`.",
          "type": "string"
        },
        "streamden": {
          "description": "App version range (SemVer range), e.g. `>=0.1.0 <1.0.0`.",
          "type": "string"
        }
      },
      "required": [
        "streamden",
        "pluginApi"
      ],
      "type": "object"
    },
    "EventContribution": {
      "additionalProperties": false,
      "description": "An event type a plugin contributes (§11). Becomes event type `<slug>.<id>`.",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "category": {
          "default": [],
          "description": "Category path for pickers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "$ref": "#/$defs/L10nString",
          "description": "Description."
        },
        "filters": {
          "default": [],
          "description": "Payload fields a trigger can filter on.",
          "items": {
            "$ref": "#/$defs/FilterableField"
          },
          "type": "array"
        },
        "highVolume": {
          "default": false,
          "description": "Delivered only when a session lists the type in `highVolume` (§8.4).",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/LocalId",
          "description": "Local ID, `lower_snake_case`."
        },
        "payload": {
          "$ref": "#/$defs/Schema",
          "description": "Payload schema (JSON Schema 2020-12, object root). Shared types are referenced as `den://schemas/v0/<Name>.json`."
        },
        "payloadVersion": {
          "description": "Payload schema version, starting at 1. A breaking change bumps it and the plugin's major version (§5.2).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "testPayload": {
          "description": "Path of a JSON fixture inside the package used by \"Test trigger\" and the simulator.",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/L10nString",
          "description": "Short title."
        }
      },
      "required": [
        "id",
        "title",
        "payloadVersion",
        "payload"
      ],
      "type": "object"
    },
    "Exposure": {
      "additionalProperties": false,
      "description": "Which surfaces expose an operation (§8.1). MCP exposure is further filtered by tier (§9.6).",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "mcp": {
          "description": "Offered as an MCP tool (only when `tier ≤ 3`, §9.6).",
          "type": "boolean"
        },
        "rpc": {
          "description": "Callable as a WS/REST method.",
          "type": "boolean"
        },
        "subAction": {
          "description": "Usable as a sub-action (`Node::Op`).",
          "type": "boolean"
        }
      },
      "required": [
        "rpc",
        "subAction",
        "mcp"
      ],
      "type": "object"
    },
    "FilterOp": {
      "description": "Filter operators (§6.2). A closed union: adding a value is a breaking change (§7.2).",
      "oneOf": [
        {
          "const": "eq",
          "description": "Equal.",
          "type": "string"
        },
        {
          "const": "ne",
          "description": "Not equal.",
          "type": "string"
        },
        {
          "const": "in",
          "description": "Member of the list in `value`.",
          "type": "string"
        },
        {
          "const": "not_in",
          "description": "Not a member of the list in `value`.",
          "type": "string"
        },
        {
          "const": "gte",
          "description": "Greater than or equal.",
          "type": "string"
        },
        {
          "const": "lte",
          "description": "Less than or equal.",
          "type": "string"
        },
        {
          "const": "between",
          "description": "Between `value[0]` and `value[1]`, inclusive.",
          "type": "string"
        },
        {
          "const": "contains",
          "description": "String or array contains `value`.",
          "type": "string"
        },
        {
          "const": "regex",
          "description": "Matches the regular expression in `value`.",
          "type": "string"
        },
        {
          "const": "exists",
          "description": "The field is present (`value` is `true`) or absent (`false`).",
          "type": "string"
        }
      ]
    },
    "FilterableField": {
      "additionalProperties": false,
      "description": "A payload field a trigger can filter on (§6.2).",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "field": {
          "description": "Dotted path into the payload.",
          "type": "string"
        },
        "ops": {
          "description": "Allowed operators.",
          "items": {
            "$ref": "#/$defs/FilterOp"
          },
          "type": "array"
        },
        "optionsFrom": {
          "description": "An operation name whose result feeds the value picker, when the field has known values.",
          "type": "string"
        },
        "specificity": {
          "default": 0,
          "description": "Rank used by spec 03's \"specific beats any\" precedence; higher is more specific.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "field",
        "ops"
      ],
      "type": "object"
    },
    "L10nString": {
      "description": "A user-facing string. In plugin manifests it may hold `%key%` placeholders resolved from the plugin's\nlocalisation files (§11); these are never templates.",
      "type": "string"
    },
    "LocalId": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "OperationContribution": {
      "additionalProperties": false,
      "description": "An operation a plugin contributes (§11). Becomes method `<slug>.<id>`. A declared tier lower than the\nhost's classification of the permissions it uses is raised.",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "category": {
          "default": [],
          "description": "Category path for pickers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "$ref": "#/$defs/L10nString",
          "description": "Description."
        },
        "examples": {
          "default": [],
          "description": "Examples (§8.1).",
          "items": {
            "$ref": "#/$defs/OperationExample"
          },
          "type": "array"
        },
        "expose": {
          "$ref": "#/$defs/Exposure",
          "description": "Which surfaces expose it."
        },
        "external": {
          "default": false,
          "description": "Talks to an external platform or app.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/LocalId",
          "description": "Local ID, `lower_snake_case`."
        },
        "idempotent": {
          "default": false,
          "description": "Repeating the call has no further effect.",
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/Schema",
          "description": "Author params schema (object root). Leaf fields may carry `x-den-template` (§10.1)."
        },
        "platforms": {
          "description": "OS gate (§14).",
          "items": {
            "$ref": "#/$defs/Os"
          },
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/Schema",
          "description": "Result schema. Object root for tier ≥ 1."
        },
        "scopes": {
          "default": [],
          "description": "Scopes the caller needs.",
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "type": "array"
        },
        "sentence": {
          "$ref": "#/$defs/L10nString",
          "description": "Sentence shown in the sub-action list, with `{param}` placeholders: `Send {message} to Acme chat`."
        },
        "tier": {
          "$ref": "#/$defs/RiskTier",
          "description": "Declared risk tier (§8.1); the host may raise it."
        },
        "timeoutMs": {
          "description": "Deadline in milliseconds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "$ref": "#/$defs/L10nString",
          "description": "Short title."
        }
      },
      "required": [
        "id",
        "title",
        "params",
        "tier",
        "expose"
      ],
      "type": "object"
    },
    "OperationExample": {
      "additionalProperties": false,
      "description": "An operation example (§8.1). Examples are tests: CI validates `params` against the params schema and\n`result` against the schema `shape` selects.",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "params": {
          "description": "The params sent. For a dry-run example they include `dryRun: true`."
        },
        "result": {
          "description": "The result returned."
        },
        "shape": {
          "$ref": "#/$defs/ResultShape",
          "description": "Which of the three result shapes `result` is."
        },
        "title": {
          "description": "Short title.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "params",
        "shape",
        "result"
      ],
      "type": "object"
    },
    "Os": {
      "description": "Operating systems an operation can be gated to (§8.1, §14).",
      "oneOf": [
        {
          "const": "windows",
          "description": "Windows.",
          "type": "string"
        },
        {
          "const": "linux",
          "description": "Linux.",
          "type": "string"
        },
        {
          "const": "macos",
          "description": "macOS.",
          "type": "string"
        }
      ]
    },
    "PluginId": {
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "type": "string"
    },
    "ResultShape": {
      "description": "The three result shapes of §8.1.",
      "oneOf": [
        {
          "const": "normal",
          "description": "The normal result: the effect happened.",
          "type": "string"
        },
        {
          "const": "dry_run",
          "description": "A [`crate::DryRunResult`]: nothing executed.",
          "type": "string"
        },
        {
          "const": "draft",
          "description": "A [`crate::DraftResult`]: deferred into a draft.",
          "type": "string"
        }
      ]
    },
    "RiskTier": {
      "description": "Risk tier (Spec 02 §8.1): 0 read, 1 reversible write, 2 configuration change, 3 external or irreversible, 4 dangerous.",
      "maximum": 4,
      "minimum": 0,
      "type": "integer"
    },
    "Runtime": {
      "description": "How a plugin runs (§11), tagged by `kind`. `wasm` is reserved and rejected in v0.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "No code: HTTP/WS requests described in the manifest.",
          "patternProperties": {
            "^x-": true
          },
          "properties": {
            "kind": {
              "const": "declarative",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "JavaScript in the host's extension process.",
          "patternProperties": {
            "^x-": true
          },
          "properties": {
            "entry": {
              "description": "Entry module, relative to the package root.",
              "type": "string"
            },
            "isolation": {
              "description": "`process` (shared extension host, default) or `dedicated` (own process).",
              "type": "string"
            },
            "kind": {
              "const": "js",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "entry"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A separate process speaking JSON-RPC over stdio (§8.6).",
          "patternProperties": {
            "^x-": true
          },
          "properties": {
            "command": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Executable per OS (`windows`, `macos`, `linux`), relative to the package root.",
              "type": "object"
            },
            "entry": {
              "description": "The script entry point, when `interpreter` is set.",
              "type": "string"
            },
            "interpreter": {
              "description": "An interpreter requirement such as `python>=3.12`, when the sidecar is a script.",
              "type": "string"
            },
            "kind": {
              "const": "sidecar",
              "type": "string"
            },
            "requirements": {
              "description": "A lock file of the script's dependencies, when `interpreter` is set.",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Schema": {
      "type": [
        "object",
        "boolean"
      ]
    },
    "Scope": {
      "pattern": "^[a-z][a-z0-9_]*(:[a-z][a-z0-9_]*(:[^\\s]+)?)?$",
      "type": "string"
    },
    "Slug": {
      "pattern": "^[a-z][a-z0-9_]{1,23}$",
      "type": "string"
    }
  },
  "$id": "den://schemas/v0/plugin.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`plugin.json` (§11). Required: `id`, `slug`, `name`, `version`, `license`.",
  "patternProperties": {
    "^x-": true
  },
  "properties": {
    "$schema": {
      "description": "URL of the schema this manifest follows; the app always validates against its bundled copy.",
      "type": "string"
    },
    "activation": {
      "default": [],
      "description": "Activation events (B2); fixed in spec 12.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "author": {
      "$ref": "#/$defs/Author",
      "description": "The author."
    },
    "categories": {
      "default": [],
      "description": "Marketplace categories.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "connection": {
      "description": "Connection definition (B2); fixed in spec 12. Carried as opaque JSON in v0."
    },
    "contributes": {
      "$ref": "#/$defs/Contributes",
      "default": {
        "chatSources": [],
        "commands": [],
        "conditions": [],
        "events": [],
        "operations": [],
        "overlayWidgets": [],
        "panels": [],
        "templates": [],
        "ttsVoices": [],
        "variables": []
      },
      "description": "What the plugin contributes."
    },
    "definitions": {
      "additionalProperties": {
        "$ref": "#/$defs/Schema"
      },
      "default": {},
      "description": "Local JSON Schema definitions, referenced as `#/definitions/<Name>`.",
      "type": "object"
    },
    "description": {
      "$ref": "#/$defs/L10nString",
      "description": "Short description."
    },
    "engines": {
      "$ref": "#/$defs/Engines",
      "description": "Host version requirements."
    },
    "homepage": {
      "description": "Homepage URL.",
      "type": "string"
    },
    "icon": {
      "description": "Path of a monochrome SVG icon inside the package.",
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/PluginId",
      "description": "Reverse-DNS plugin ID (§4)."
    },
    "keywords": {
      "default": [],
      "description": "Search keywords.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "l10n": {
      "description": "Localisation configuration for `%key%` placeholders; fixed in spec 12. Carried as opaque JSON in v0."
    },
    "license": {
      "description": "SPDX license expression.",
      "type": "string"
    },
    "manifestVersion": {
      "description": "Always `0` for this schema. v0 is pre-stable.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "$ref": "#/$defs/L10nString",
      "description": "Display name."
    },
    "permissions": {
      "description": "Permissions (B2); fixed in spec 12. Carried as opaque JSON in v0."
    },
    "repository": {
      "description": "Source repository URL.",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/Runtime",
      "description": "How the plugin runs."
    },
    "settings": {
      "$ref": "#/$defs/Schema",
      "description": "Plugin-wide settings: a JSON Schema with `x-ui` hints and `x-secret` (B2.4). Always literal (§10.1)."
    },
    "slug": {
      "$ref": "#/$defs/Slug",
      "description": "Short slug: the prefix of every contribution (§4). Must not be a reserved slug."
    },
    "version": {
      "description": "SemVer version.",
      "type": "string"
    }
  },
  "required": [
    "manifestVersion",
    "id",
    "slug",
    "name",
    "version",
    "license",
    "engines",
    "runtime"
  ],
  "title": "PluginManifest",
  "type": "object"
}
