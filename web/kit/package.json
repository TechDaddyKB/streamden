{
  "name": "@streamden/kit",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "node scripts/build-css.mjs --check && node scripts/check-contrast.mjs --quiet && tsc -p tsconfig.json",
