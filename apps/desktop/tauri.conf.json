{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamDen",
  "mainBinaryName": "streamden",
  "version": "0.0.0",
  "identifier": "com.techdaddydigital.streamden",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/ui/dist",
    "beforeDevCommand": "pnpm --filter @streamden/ui dev",
    "beforeBuildCommand": "pnpm --filter @streamden/ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StreamDen",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "publisher": "Tech Daddy Digital",
    "homepage": "https://github.com/tech-daddy-digital/streamden",
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "StreamDen streaming automation hub",
    "createUpdaterArtifacts": false,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "544682fc-4369-5784-9d8b-20cea11a1e99",
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "compression": "lzma"
      }
    }
  }
}
